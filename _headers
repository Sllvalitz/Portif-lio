# Headers de segurança e cache — formato Netlify / Cloudflare Pages.
# Em outros hosts (Vercel, Nginx, Apache, GitHub Pages) os mesmos valores
# vão em vercel.json / nginx.conf / .htaccess — GitHub Pages não permite
# headers customizados.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'sha256-jUZxtWpw4DV0IQhRX5H3ru1e1dp8mw4R5M/IbwaAJK8='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cdn.simpleicons.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# ── DEEP LINKING: /projetos/<slug> ─────────────────────────────────────
# O JavaScript só cuida da History API. Num acesso direto (ou F5) a
# /projetos/<slug> o SERVIDOR precisa responder com o index.html
# (status 200, sem redirecionar, mantendo a URL). UMA regra cobre todos os
# projetos (um único segmento depois de /projetos/): quem valida o slug é o
# JS, contra o `id` de data/projects.json — slug desconhecido volta para "/".
# Arquivos que existem de verdade continuam sendo servidos normalmente.
# Adicionar um projeto novo NÃO exige mexer nesta configuração.
#
# Netlify / Cloudflare Pages — arquivo `_redirects` na raiz (não vai aqui):
#   /projetos/*  /index.html  200
# Nginx:
#   location ~ ^/projetos/[^/]+/?$ { try_files /index.html =404; }
# Vercel (vercel.json): "rewrites": [{ "source": "/projetos/:slug", "destination": "/index.html" }]
# GitHub Pages: não suporta rewrite — o acesso direto não funciona nesse host.
/projetos/*
  Cache-Control: no-cache

# HTML sempre revalidado; CSS/JS 1h (os nomes não têm hash de versão,
# então cache longo exigiria renomear a cada deploy); assets 30 dias.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/assets/*
  Cache-Control: public, max-age=2592000
